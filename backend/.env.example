# Backend Environment Variables

# Server port
PORT=5000

# MongoDB Connection String
# For local development: mongodb://localhost:27017/room-planner
# For MongoDB Atlas: mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/room-planner?retryWrites=true&w=majority&appName=Cluster0
# Important: URL encode your password if it contains special characters (?, @, #, etc.)
MONGODB_URI=mongodb://localhost:27017/room-planner

# JWT Secret Key - CHANGE THIS IN PRODUCTION!
# Generate a strong random string for production
JWT_SECRET=your-secret-key-change-this-in-production

# Environment
# development | production
NODE_ENV=development

# Frontend URL(s) (for CORS) — comma-separated list of allowed origins
# Local development: http://localhost:5173
# Production: https://your-frontend-url.vercel.app
# Multiple (e.g. production + a Vercel preview deployment):
#   FRONTEND_URL=https://myapp.vercel.app,https://myapp-git-branch-user.vercel.app
FRONTEND_URL=http://localhost:5173
